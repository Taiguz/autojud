{
  "name": "autojud",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/app.js",
    "start:dev": "npm run build && DEBUG=autojud:* node ./dist/app.js",
    "start:debug": "npm run build && DEBUG=autojud:* node --inspect ./dist/app.js",
    "postinstall": "npm run build && cd front && npm install && npm install --dev && npm run build",
    "cron:andamentos": "node ./dist/src/cron/buscarAndamentos.js",
    "cron:tarefas": "node ./dist/src/cron/buscarTarefasVencimento.js",
    "cron:andamentos:dev": "npm run build && node ./dist/src/cron/buscarAndamentos.js",
    "cron:tarefas:dev": "npm run build && node ./dist/src/cron/buscarTarefasVencimento.js",
    "cron:tarefas:debug": "npm run build && node --inspect ./dist/src/cron/buscarTarefasVencimento.js",
    "deploy": "npm run build && ./deploy.sh"
  },
  "dependencies": {
    "axios": "^0.26.0",
    "bcrypt": "^5.0.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "cron": "^2.1.0",
    "date-fns": "^2.29.3",
    "debug": "~2.6.9",
    "dotenv": "^16.0.0",
    "express": "~4.16.1",
    "express-jwt": "^7.7.5",
    "jsonwebtoken": "^8.5.1",
    "morgan": "~1.9.1",
    "nodemailer": "^6.7.7",
    "nodemailer-mailgun-transport": "^2.1.4",
    "pg": "^8.7.3",
    "pg-hstore": "^2.3.4",
    "rotating-file-stream": "^3.0.4",
    "sequelize": "^6.21.3",
    "winston": "^3.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.12",
    "@types/cron": "^2.0.0",
    "@types/debug": "^4.1.7",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/node": "^17.0.0",
    "@types/nodemailer": "^6.4.4",
    "@types/nodemailer-mailgun-transport": "^1.4.3",
    "ts-node-dev": "^1.1.8",
    "typescript": "4.9.3"
  }
}
